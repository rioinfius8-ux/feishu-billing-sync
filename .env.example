# Feishu Application
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Feishu Base
FEISHU_APP_TOKEN=
FEISHU_TABLE_ID=

# Google Sheets
GOOGLE_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./credentials/google-service-account.json
GOOGLE_SHEET_NAME=

# Optional
# FEISHU_DOMAIN=feishu          # or "lark" for larksuite.com
# SYNC_INTERVAL_MINUTES=10
# TIMEZONE=Asia/Manila
# UNIQUE_KEY_FIELD=Invoice No   # if set, imports update existing records with the same value instead of duplicating
# HIDDEN_COLUMNS=SourceID,Approval steps   # comma-separated field names to hide in Google Sheets
# APPROVAL_STEPS=QB Handled=QB Handle;Bank Maked=Bank Maker   # extra columns from approval record (needs approval:approval:readonly)
# APPROVAL_CODE=          # approval definition code; when set, Approval API becomes the row source
# APPROVAL_BACKFILL_FROM=2026-01-01T00:00:00+08:00
